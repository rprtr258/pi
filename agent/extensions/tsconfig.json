{
  // Single project covering every TypeScript source in the repo. Per-directory
  // package versions still resolve via each extension's own node_modules.
  "include": ["**/*.ts"],
  "exclude": [
    "harness-self-improvement/runs",
    "harness-self-improvement/loop/suite/**/broken",
    "harness-self-improvement/loop/suite/**",
    "harness-self-improvement/loop/suite-replay/**",
  ],
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  }
}
